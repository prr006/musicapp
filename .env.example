# MELO API
ADDR=:8080
MELO_ENV=development
MELO_DATA_DIR=./data
MELO_YTDLP=/absolute/path/to/yt-dlp
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# Generate independent values with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes
PLAYBACK_SIGNING_KEY=replace-with-another-at-least-32-random-value

SEARCH_TIMEOUT=20s
RESOLVE_TIMEOUT=45s
LYRICS_TIMEOUT=15s

# Reserved for the PostgreSQL repository adapter. The current lightweight
# development repository stores isolated account documents under MELO_DATA_DIR.
DATABASE_URL=postgresql://melo:password@localhost:5432/melo?sslmode=disable
