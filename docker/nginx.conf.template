# Serves the MELO static web bundle. The nginx image substitutes ${PORT} at
# container start (20-envsubst-on-templates.sh), so Railway's injected port is
# honored automatically.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Vite emits content-hashed asset names: cache them immutably.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
